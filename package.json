{
  "name": "zatlan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:backend": "pnpm --filter zatlan-backend run dev",
    "dev:frontend": "pnpm --filter zatlan-frontend run dev",
    "build": "pnpm -r run build",
    "build:local": "pnpm --filter zatlan-backend run build && pnpm --filter zatlan-frontend run build:local",
    "start": "pnpm run build:local && pnpm --parallel -r run start:local",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm --filter zatlan-backend run typecheck && pnpm --filter zatlan-frontend exec tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "@firebase/util"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.68.0"
  }
}
