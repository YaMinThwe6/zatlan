# Loaded only under `vite build --mode localstart` (frontend's build:local
# script) — a mode name other than "production" so .env.production's
# deployed Cloud Run URL never leaks into this build. Points at the isolated
# local backend (backend/.env.local-start's PORT=6502), not the dev backend
# on 6501 — this build is meant to run standalone alongside a live dev
# server, not against it. No secrets — safe to commit, same as .env.production.
VITE_API_BASE_URL=http://localhost:6502
